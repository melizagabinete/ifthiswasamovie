    "@radix-ui/react-slot": "^1.2.3",
    "@vercel/functions": "^3.1.0",
    "better-auth": "^1.3.9",
    "bwip-js": "^4.8.0",
    "canvas": "^3.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.510.0",
    "mongodb": "^6.21.0",
    "next": "^15.1.9",
    "next-themes": "^0.4.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.62.0",
    "sonner": "^2.0.7",
